// Morning — intention, focus, lens for the day
"prompts.openers.morning.1" = "O que você quer que seja diferente hoje?";
"prompts.openers.morning.2" = "O que mais importa hoje?";
"prompts.openers.morning.3" = "Hoje volto a pensar em...";
"prompts.openers.morning.4" = "A primeira coisa na minha cabeça hoje cedo é...";
"prompts.openers.morning.5" = "Não precisa planejar o dia. Comece com uma palavra.";
"prompts.openers.morning.6" = "Sem metas. Só diga de onde está partindo.";
"prompts.openers.morning.7" = "Energia agora: pesada, suave, afiada ou espalhada?";
"prompts.openers.morning.8" = "Humor a esta hora: calmo, ansioso, nublado ou pronto?";
"prompts.openers.morning.9" = "O que o resto de você quer hoje?";
"prompts.openers.morning.10" = "Manhãs são quando o dia ainda parece aberto. O que vier primeiro, escreva. Não precisa significar nada ainda.";

// Evening — release, what stayed
"prompts.openers.evening.1" = "O que ficou com você hoje?";
"prompts.openers.evening.2" = "O que ainda está girando do dia?";
"prompts.openers.evening.3" = "Aquilo a que volto do dia é...";
"prompts.openers.evening.4" = "Se o dia tivesse uma palavra, seria...";
"prompts.openers.evening.5" = "O dia acabou. O que não disse pode pousar aqui.";
"prompts.openers.evening.6" = "Não precisa resumir. Um pedaço pequeno basta.";
"prompts.openers.evening.7" = "Como o dia foi: leve, pesado, misturado ou borrado?";
"prompts.openers.evening.8" = "O que mais notou: pessoas, trabalho, corpo ou silêncio?";
"prompts.openers.evening.9" = "O que te surpreendeu hoje?";
"prompts.openers.evening.10" = "As noites carregam o que sobrou. O pensamento que não achou lugar, a coisa pequena que ainda está alta. Coloque aqui.";

// Late night — won't quiet, can't sleep
"prompts.openers.late_night.1" = "O que não deixa você dormir?";
"prompts.openers.late_night.2" = "Que pensamento te mantém acordado?";
"prompts.openers.late_night.3" = "O pensamento que volta esta noite é...";
"prompts.openers.late_night.4" = "O que está alto agora é...";
"prompts.openers.late_night.5" = "Não precisa resolver hoje. Só nomeie.";
"prompts.openers.late_night.6" = "É tarde. Pequeno basta.";
"prompts.openers.late_night.7" = "Onde mora no corpo: peito, cabeça, estômago ou tudo?";
"prompts.openers.late_night.8" = "Palavra mais perto: ansioso, triste, inquieto ou ligado?";
"prompts.openers.late_night.9" = "O que ajudaria agora, mesmo que pouco?";
"prompts.openers.late_night.10" = "A noite aumenta as coisas. O que estiver te mantendo acordado, pode pousar aqui sem resolver. Que aterrise já é o suficiente.";

// Stuck — too many things, can't pick
"prompts.openers.stuck.1" = "O que te puxa de todos os lados?";
"prompts.openers.stuck.2" = "Se só pudesse pensar em uma coisa, qual?";
"prompts.openers.stuck.3" = "O fio mais alto agora é...";
"prompts.openers.stuck.4" = "Se tivesse que escolher um para começar, seria...";
"prompts.openers.stuck.5" = "Não precisa desembaraçar tudo. Pedaço por pedaço.";
"prompts.openers.stuck.6" = "Travar tudo bem. Comece de qualquer lugar.";
"prompts.openers.stuck.7" = "O que está mais embolado: tempo, pessoas, escolhas ou sentimentos?";
"prompts.openers.stuck.8" = "Por onde começar: o menor, o mais alto, o mais antigo ou o mais novo?";
"prompts.openers.stuck.9" = "Como seria mexer um pouquinho?";
"prompts.openers.stuck.10" = "Quando tudo fala junto, não precisa ouvir tudo. Pegue o fio mais perto e puxe. O resto pode esperar.";

