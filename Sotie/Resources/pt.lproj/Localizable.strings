"prompts.openers.replay.1" = "Que pensamento volta?";
"prompts.openers.replay.2" = "Que parte fica repetindo?";
"prompts.openers.replay.3" = "A cena à qual volto é...";
"prompts.openers.replay.4" = "A frase que ainda toca na minha cabeça é...";
