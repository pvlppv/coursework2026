"prompts.openers.heavy.8" = "Onde sente: peito, garganta, estômago ou tudo?";
"prompts.openers.heavy.9" = "O que dói por baixo da dor?";
"prompts.openers.heavy.10" = "O pesado nem sempre tem motivo claro. Às vezes só está. Em qualquer formato, pode pousar aqui por um minuto.";

