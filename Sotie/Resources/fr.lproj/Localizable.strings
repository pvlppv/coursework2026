// Morning — intention, focus, lens for the day
"prompts.openers.morning.1" = "Que veux-tu faire autrement aujourd'hui ?";
"prompts.openers.morning.2" = "Qu'est-ce qui compte le plus aujourd'hui ?";
"prompts.openers.morning.3" = "Aujourd'hui je reviens à...";
"prompts.openers.morning.4" = "La première chose que j'ai en tête ce matin, c'est...";
"prompts.openers.morning.5" = "Pas besoin de planifier la journée. Commence par un mot.";
"prompts.openers.morning.6" = "Aucun objectif. Dis juste d'où tu pars.";
"prompts.openers.morning.7" = "Énergie maintenant : lourde, douce, vive ou éparpillée ?";
"prompts.openers.morning.8" = "Humeur à cette heure : calme, anxieuse, brumeuse ou prête ?";
"prompts.openers.morning.9" = "Que veut le reste de toi aujourd'hui ?";
"prompts.openers.morning.10" = "Le matin, la journée est encore ouverte. Ce qui vient en premier, écris-le. Ça n'a pas besoin de signifier quoi que ce soit.";

// Evening — release, what stayed
"prompts.openers.evening.1" = "Qu'est-ce qui est resté avec toi aujourd'hui ?";
"prompts.openers.evening.2" = "Qu'est-ce qui tourne encore depuis aujourd'hui ?";
"prompts.openers.evening.3" = "Ce qui me revient d'aujourd'hui, c'est...";
"prompts.openers.evening.4" = "Si la journée avait un mot, ce serait...";
"prompts.openers.evening.5" = "La journée est finie. Ce que tu n'as pas dit peut atterrir ici.";
"prompts.openers.evening.6" = "Pas besoin de résumer. Un petit morceau suffit.";
"prompts.openers.evening.7" = "Comment a été le jour : léger, lourd, mélangé ou flou ?";
"prompts.openers.evening.8" = "Ce que tu as le plus remarqué : les gens, le travail, le corps ou le silence ?";
"prompts.openers.evening.9" = "Qu'est-ce qui t'a surpris aujourd'hui ?";
"prompts.openers.evening.10" = "Les soirs portent ce qui reste. La pensée qui n'a pas eu de place, le petit truc qui résonne encore. Pose-le ici.";

// Late night — won't quiet, can't sleep
"prompts.openers.late_night.1" = "Qu'est-ce qui ne te laisse pas dormir ?";
"prompts.openers.late_night.2" = "Quelle pensée te tient éveillé ?";
"prompts.openers.late_night.3" = "La pensée qui revient cette nuit, c'est...";
"prompts.openers.late_night.4" = "Ce qui résonne fort là, c'est...";
"prompts.openers.late_night.5" = "Pas besoin de régler ça ce soir. Nomme-le.";
"prompts.openers.late_night.6" = "Il est tard. Petit suffit.";
"prompts.openers.late_night.7" = "Où ça vit dans le corps : poitrine, tête, ventre ou partout ?";
"prompts.openers.late_night.8" = "Mot le plus proche : anxieux, triste, agité ou survolté ?";
"prompts.openers.late_night.9" = "Qu'est-ce qui aiderait là, même un peu ?";
"prompts.openers.late_night.10" = "La nuit grossit les choses. Ce qui te tient éveillé, tu peux le poser ici sans le résoudre. Que ça atterrisse, c'est déjà assez.";

// Stuck — too many things, can't pick
"prompts.openers.stuck.1" = "Qu'est-ce qui te tire en même temps ?";
"prompts.openers.stuck.2" = "Si tu ne pouvais penser qu'à une chose, laquelle ?";
"prompts.openers.stuck.3" = "Le fil le plus fort là, c'est...";
"prompts.openers.stuck.4" = "Si je devais en choisir un pour commencer, ce serait...";
"prompts.openers.stuck.5" = "Pas besoin de tout démêler. Un morceau à la fois.";
"prompts.openers.stuck.6" = "Coincé, c'est ok. Commence n'importe où.";
"prompts.openers.stuck.7" = "Qu'est-ce qui est le plus emmêlé : le temps, les gens, les choix ou les sentiments ?";
"prompts.openers.stuck.8" = "Par où commencer : le plus petit, le plus fort, le plus ancien ou le plus neuf ?";
"prompts.openers.stuck.9" = "À quoi ressemblerait bouger un peu ?";
"prompts.openers.stuck.10" = "Quand tout parle en même temps, pas besoin d'écouter tout. Prends le fil le plus proche et tire. Le reste peut attendre.";

// Replay — one thought looping
"prompts.openers.replay.1" = "Quelle pensée revient ?";
"prompts.openers.replay.2" = "Quelle partie repasse en boucle ?";
"prompts.openers.replay.3" = "La scène à laquelle je reviens, c'est...";
"prompts.openers.replay.4" = "La phrase qui me reste en tête, c'est...";
"prompts.openers.replay.5" = "Pas besoin de comprendre pourquoi c'est encore là. Pose-le ici.";
"prompts.openers.replay.6" = "Ça peut continuer à tourner sans que tu aies à le résoudre.";
"prompts.openers.replay.7" = "Comment c'est : coincé, agité, honteux ou injuste ?";
"prompts.openers.replay.8" = "Ce que tu en veux : la fin, comprendre, une réponse ou le calme ?";
"prompts.openers.replay.9" = "Qu'est-ce que cette boucle veut de toi ?";
"prompts.openers.replay.10" = "Certaines pensées reviennent non parce que tu as raté un truc, mais parce qu'elles cherchent encore où atterrir. Que ce soit ici.";

// Heavy — sad, low, weight
"prompts.openers.heavy.1" = "Qu'est-ce qui pèse là ?";
"prompts.openers.heavy.2" = "Qu'est-ce qui est plus dur que d'habitude ?";
"prompts.openers.heavy.3" = "Le poids, c'est...";
"prompts.openers.heavy.4" = "Ce que je porte là, c'est...";
"prompts.openers.heavy.5" = "Pas besoin de l'alléger. Dis-le simplement.";
"prompts.openers.heavy.6" = "Lourd, c'est permis. Reste ici tant qu'il faut.";
"prompts.openers.heavy.7" = "Mot proche : triste, à plat, fatigué ou vide ?";
"prompts.openers.heavy.8" = "Où tu le sens : poitrine, gorge, ventre ou partout ?";
"prompts.openers.heavy.9" = "Qu'est-ce qui fait mal sous la douleur ?";
"prompts.openers.heavy.10" = "Le lourd n'a pas toujours de raison nette. Parfois c'est juste là. Quelle que soit sa forme, tu peux le poser ici un instant.";

// Frustrated — anger, blame
"prompts.openers.frustrated.1" = "Qu'est-ce qui te frustre ?";
"prompts.openers.frustrated.2" = "Qu'est-ce que tu voulais qui n'est pas arrivé ?";
"prompts.openers.frustrated.3" = "Ce qui me gonfle, c'est...";
"prompts.openers.frustrated.4" = "Ce que j'aurais voulu dire, c'est...";
"prompts.openers.frustrated.5" = "Ici, pas besoin d'être poli.";
"prompts.openers.frustrated.6" = "La frustration compte. Donne-lui des mots.";
"prompts.openers.frustrated.7" = "C'est à propos de quoi : une personne, une situation, toi-même ou l'injustice ?";
"prompts.openers.frustrated.8" = "Niveau de chaleur : ça mijote, c'est aigu, c'est chaud ou c'est cramé ?";
"prompts.openers.frustrated.9" = "Qu'est-ce qui te paraît injuste ?";
"prompts.openers.frustrated.10" = "La colère a souvent une raison dessous : quelque chose que tu voulais, quelque chose qui a été franchi. N'argumente pas. Dis ce qui s'est passé et ce dont tu avais besoin.";

// Numb — blank, can't access feeling
"prompts.openers.numb.1" = "Comment se sent le vide là ?";
"prompts.openers.numb.2" = "Que ressentais-tu avant ça ?";
"prompts.openers.numb.3" = "Là je suis juste...";
"prompts.openers.numb.4" = "Ce n'est pas rien, c'est plutôt...";
"prompts.openers.numb.5" = "Le vide compte. Pas besoin de trouver un sentiment.";
"prompts.openers.numb.6" = "Le silence aussi est une info. Reste avec.";
"prompts.openers.numb.7" = "Mot proche : lourd, vide, gelé ou calme ?";
"prompts.openers.numb.8" = "Volume du ressenti : zéro, faible, lointain ou étouffé ?";
"prompts.openers.numb.9" = "Quand le volume est-il tombé ?";
"prompts.openers.numb.10" = "Engourdi ne veut pas dire qu'il n'y a rien. Souvent ça veut dire qu'il y a quelque chose dessous sans nom encore. Pas besoin de le trouver ce soir.";

// Anxious — forward dread, can't settle
"prompts.openers.anxious.1" = "De quoi as-tu peur ?";
"prompts.openers.anxious.2" = "Où le sens-tu dans le corps ?";
"prompts.openers.anxious.3" = "Ce qui galope dans ma tête, c'est...";
"prompts.openers.anxious.4" = "Le pire scénario où je vais tout le temps, c'est...";
"prompts.openers.anxious.5" = "Pas besoin de l'arrêter. Décris-le.";
"prompts.openers.anxious.6" = "L'anxiété est bruyante. Lent, c'est ok.";
"prompts.openers.anxious.7" = "Où ça apparaît : poitrine, ventre, gorge ou souffle ?";
"prompts.openers.anxious.8" = "Rythme : rapide, en boucle, sautant ou figé ?";
"prompts.openers.anxious.9" = "À quoi ressemblerait plus calme, même un peu ?";
"prompts.openers.anxious.10" = "L'anxiété pointe souvent quelque chose mais utilise la panique comme messager. Tu n'es pas obligé de croire la panique. Écoute juste ce qu'elle pointe.";

// Restless — don't want to be where I am
"prompts.openers.restless.1" = "Qu'est-ce qui te tire là ?";
"prompts.openers.restless.2" = "Qu'est-ce qui sonne faux dans le moment ?";
"prompts.openers.restless.3" = "Je n'arrête pas de vouloir...";
"prompts.openers.restless.4" = "Là où je voudrais vraiment être, c'est...";
"prompts.openers.restless.5" = "L'agitation est une info. Ne la combats pas.";
"prompts.openers.restless.6" = "Pas besoin de savoir pour quoi. Dis juste qu'elle est là.";
"prompts.openers.restless.7" = "Comment c'est : ça démange, c'est ennuyeux, enfermé ou nerveux ?";
"prompts.openers.restless.8" = "Qu'est-ce qui cloche : lieu, rythme, gens ou toi-même ?";
"prompts.openers.restless.9" = "Vers quoi pointe l'agitation ?";
"prompts.openers.restless.10" = "L'agitation veut souvent dire qu'une partie de toi veut autre chose que ce qui se passe. Pas besoin d'agir. Note juste ce qu'elle vise.";

