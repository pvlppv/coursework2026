"prompts.openers.decision.1" = "Quel choix évites-tu ?";
"prompts.openers.decision.2" = "Que veux-tu vraiment, avant les raisons ?";
"prompts.openers.decision.3" = "Ce sur quoi je vais et viens, c'est...";
"prompts.openers.decision.4" = "Si personne ne regardait, je...";
"prompts.openers.decision.5" = "Pas besoin de décider ce soir. Juste voir plus clair.";
"prompts.openers.decision.6" = "Pas de mauvaise réponse ici. Que des honnêtes.";
"prompts.openers.decision.7" = "Qu'est-ce qui te bloque : la peur, l'équité, les autres ou l'argent ?";
"prompts.openers.decision.8" = "Comment c'est : coincé, déchiré, urgent ou tranquille ?";
"prompts.openers.decision.9" = "Qu'est-ce que rester immobile te coûte ?";
"prompts.openers.decision.10" = "Les décisions deviennent claires quand tu arrêtes de te disputer avec toi-même et que tu écoutes. Dis d'abord ce que tu veux. Les raisons viendront après.";

// Someone — about another person
"prompts.openers.someone.1" = "Qui as-tu en tête là ?";
"prompts.openers.someone.2" = "Qu'ont-ils dit ou fait ?";
"prompts.openers.someone.3" = "La personne à qui je pense, c'est...";
"prompts.openers.someone.4" = "Ce que j'aimerais qu'ils comprennent, c'est...";
"prompts.openers.someone.5" = "Ici, pas besoin d'être juste.";
"prompts.openers.someone.6" = "Ce que tu ne peux pas leur dire, dis-le ici.";
"prompts.openers.someone.7" = "Ce que tu ressens pour eux : blessé, en colère, ils te manquent ou déchiré ?";
"prompts.openers.someone.8" = "Ce qui reste entre vous : silence, distance, mots ou espoir ?";
"prompts.openers.someone.9" = "De quoi avais-tu besoin de leur part ?";
"prompts.openers.someone.10" = "Les gens laissent des traces. Même quand rien ne s'est passé, quelque chose peut rester. Qui que ce soit, commence par eux et ce qu'ils déclenchent en toi.";

// You vs them — self vs others, "we", "should"
"prompts.openers.you_vs_them.1" = "Que veux-tu, à part eux ?";
"prompts.openers.you_vs_them.2" = "C'est pour qui, vraiment ?";
"prompts.openers.you_vs_them.3" = "Si dire non ne me coûtait rien, je...";
"prompts.openers.you_vs_them.4" = "Ce que je veux vraiment, pas ce que je devrais vouloir, c'est...";
"prompts.openers.you_vs_them.5" = "Tu as le droit de vouloir autre chose qu'eux.";
"prompts.openers.you_vs_them.6" = "Être honnête avec toi n'est pas une trahison.";
"prompts.openers.you_vs_them.7" = "Quelle voix est la plus forte : la tienne, la famille, le partenaire ou la culture ?";
"prompts.openers.you_vs_them.8" = "Que perdrais-tu en choisissant la tienne : approbation, confort, paix ou culpabilité ?";
"prompts.openers.you_vs_them.9" = "Que fait ce 'je devrais' dans ta tête ?";
"prompts.openers.you_vs_them.10" = "Parfois le plus dur, c'est d'entendre ta voix au-dessus des autres. Pas besoin de choisir. Laisse juste la tienne être la plus forte ici.";

// Change — transitions, endings, beginnings
"prompts.openers.change.1" = "Qu'est-ce qui change ?";
"prompts.openers.change.2" = "Que laisses-tu derrière ?";
"prompts.openers.change.3" = "Ce que je ne suis pas sûr d'être prêt à laisser, c'est...";
"prompts.openers.change.4" = "Ce vers quoi je tends, c'est...";
"prompts.openers.change.5" = "Tu peux pleurer ce que tu quittes et vouloir la suite.";
"prompts.openers.change.6" = "L'entre-deux est permis. Pas besoin d'être posé.";
"prompts.openers.change.7" = "Comment c'est : effrayant, excitant, triste ou tout à la fois ?";
"prompts.openers.change.8" = "Où tu en es : à la fin, au milieu, au début ou flou ?";
"prompts.openers.change.9" = "Qu'est-ce qui est deuil et qu'est-ce qui est espoir ?";
"prompts.openers.change.10" = "Le changement est rarement un seul sentiment. Il y a une part qui dit au revoir et une qui tend la main. Les deux peuvent être vraies en même temps.";

// Wins — what clicked, breakthroughs
"prompts.openers.wins.1" = "Qu'est-ce qui a marché aujourd'hui ?";
"prompts.openers.wins.2" = "Qu'est-ce qui t'a surpris en toi ?";
"prompts.openers.wins.3" = "Quelque chose que j'ai bien fait aujourd'hui, c'est...";
"prompts.openers.wins.4" = "Une petite chose qui a fonctionné, c'est...";
"prompts.openers.wins.5" = "Petit compte. Pas besoin de l'appeler grand.";
"prompts.openers.wins.6" = "Prends-le. Tu l'as gagné.";
"prompts.openers.wins.7" = "Où est la victoire : action, état d'esprit, gentillesse ou repos ?";
"prompts.openers.wins.8" = "Comment c'est : fier, soulagé, surpris ou stable ?";
"prompts.openers.wins.9" = "Qu'est-ce que toi-d'avant a fait qui a aidé ?";
"prompts.openers.wins.10" = "Les victoires n'ont pas besoin d'être bruyantes ou visibles. Parfois la victoire, c'est de ne pas avoir spiralé. Parfois, d'avoir commencé. Quelle que soit la tienne, compte-la.";

// Gratitude — what's already there
"prompts.openers.gratitude.1" = "Qu'est-ce qui mérite d'être noté aujourd'hui ?";
"prompts.openers.gratitude.2" = "Qu'est-ce qu'on oublie facilement mais qui compte ?";
"prompts.openers.gratitude.3" = "Une petite chose qui me fait plaisir, c'est...";
"prompts.openers.gratitude.4" = "Ce qui a aidé, ne serait-ce qu'un peu, c'était...";
"prompts.openers.gratitude.5" = "Ne force pas. Note juste ce qui est déjà là.";
"prompts.openers.gratitude.6" = "Petit suffit.";
"prompts.openers.gratitude.7" = "Où regarder : une personne, un moment, un lieu ou ton corps ?";
"prompts.openers.gratitude.8" = "Quel genre : utile, doux, ordinaire ou inattendu ?";
"prompts.openers.gratitude.9" = "Qu'est-ce que tu as failli rater aujourd'hui ?";
"prompts.openers.gratitude.10" = "La gratitude n'a pas besoin d'être une longue liste. Une chose précise, quelqu'un qui était là, une fenêtre de calme, ton corps qui fait son boulot, ça suffit.";

// Patterns — meta, recurring shapes
"prompts.openers.patterns.1" = "Qu'est-ce qui revient ces derniers temps ?";
"prompts.openers.patterns.2" = "Qu'est-ce qui est pareil dans des situations différentes ?";
"prompts.openers.patterns.3" = "Ce que je n'arrête pas de faire, c'est...";
"prompts.openers.patterns.4" = "Je remarque que ça arrive quand...";
"prompts.openers.patterns.5" = "Les schémas ne sont pas des verdicts. Ce sont des infos.";
"prompts.openers.patterns.6" = "Pas besoin de réparer juste parce que tu as vu.";
"prompts.openers.patterns.7" = "Où ça apparaît : travail, relations, santé ou humeurs ?";
"prompts.openers.patterns.8" = "Type de schéma : éviter, atteindre, répéter ou se rétrécir ?";
"prompts.openers.patterns.9" = "À quoi ça te fait penser ?";
"prompts.openers.patterns.10" = "Les schémas ne prouvent pas toujours qu'il y a un problème. Parfois ce sont de vieilles solutions qui marchaient avant et qui ne marchent plus. En nommer un est un premier pas doux.";

// Future self — the version of you ahead
"prompts.openers.future_self.1" = "Que voudrait que tu saches ton toi du futur ?";
"prompts.openers.future_self.2" = "Qu'est-ce que tu veux qui soit vrai dans un an ?";
"prompts.openers.future_self.3" = "Dans un an, je veux être...";
"prompts.openers.future_self.4" = "Ce dont je remercierais mon toi d'avant, c'est...";
"prompts.openers.future_self.5" = "Le toi du futur ne juge pas. Il espère pour toi.";
"prompts.openers.future_self.6" = "Les petits commencements comptent.";
"prompts.openers.future_self.7" = "Vers quoi tu construis : clarté, courage, légèreté ou honnêteté ?";
"prompts.openers.future_self.8" = "Par où commencer : habitude, relation, travail ou toi-même ?";
"prompts.openers.future_self.9" = "Quelle est la petite chose qui s'accumule ?";
"prompts.openers.future_self.10" = "Le toi du futur n'est pas un étranger. C'est la version de toi qui sait ce que cette version-ci portait. Quoi que tu lui dises, elle écoute.";

// Returning — long gap (>3 days)
"prompts.openers.returning.1" = "Qu'est-ce qui est resté depuis la dernière fois ?";
"prompts.openers.returning.2" = "Qu'est-ce qui a changé ?";
"prompts.openers.returning.3" = "Depuis ma dernière visite, ce qui est resté, c'est...";
"prompts.openers.returning.4" = "Ce qui m'a ramené aujourd'hui, c'est...";
"prompts.openers.returning.5" = "Pas besoin d'expliquer la pause. Pars de maintenant.";
"prompts.openers.returning.6" = "Bienvenue. Là où tu commences est le bon endroit.";
"prompts.openers.returning.7" = "Qu'est-ce qui est plus fort maintenant : le même, du nouveau ou plus calme ?";
"prompts.openers.returning.8" = "Comment tu te sens en revenant : fatigué, content, pas sûr ou prêt ?";
"prompts.openers.returning.9" = "De quoi la pause t'a-t-elle rappelé ?";
"prompts.openers.returning.10" = "Tu es revenu. Ça compte. Ce qui est resté dans le silence entre les visites, tu peux le poser ici sans explication.";

// Continue — fresh thread (<24h, has assistant reply)
"prompts.openers.continue.1" = "Où en étais-tu ?";
"prompts.openers.continue.2" = "Qu'est-ce qui tourne encore depuis tout à l'heure ?";
"prompts.openers.continue.3" = "Je reprends là où j'en étais, et ce qui résonne encore, c'est...";
"prompts.openers.continue.4" = "Ce sur quoi je veux revenir, c'est...";
"prompts.openers.continue.5" = "Tu peux reprendre au milieu. Pas besoin de tout recommencer.";
"prompts.openers.continue.6" = "Ce qui est encore là vaut une minute de plus.";
"prompts.openers.continue.7" = "Qu'est-ce qui est plus clair : un peu, plutôt ou encore flou ?";
"prompts.openers.continue.8" = "Qu'est-ce qui te ramène : un sentiment, une pensée, une personne ou la boucle elle-même ?";
"prompts.openers.continue.9" = "Quelle est la prochaine chose que tu veux dire ?";
"prompts.openers.continue.10" = "Certaines pensées demandent plus d'une séance. Tu peux revenir autant de fois qu'il faut. Le fil est encore là.";

// Brain dump — catch-all
"prompts.openers.brain_dump.1" = "Qu'as-tu en tête là ?";
"prompts.openers.brain_dump.2" = "Qu'est-ce qui fait le plus de bruit dans ta tête ?";
"prompts.openers.brain_dump.3" = "Là, ma tête est pleine de...";
"prompts.openers.brain_dump.4" = "La première chose qui vient, c'est...";
"prompts.openers.brain_dump.5" = "Le bazar est bienvenu. Pas besoin de structure.";
"prompts.openers.brain_dump.6" = "Écris juste. Le sens peut venir après.";
"prompts.openers.brain_dump.7" = "Volume : fort, éparpillé, en boucle ou silencieux mais coincé ?";
"prompts.openers.brain_dump.8" = "À propos de quoi : aujourd'hui, ces derniers temps, depuis toujours ou pas clair ?";
"prompts.openers.brain_dump.9" = "Quelle pensée te suit ?";
"prompts.openers.brain_dump.10" = "Une vidange mentale n'a pas besoin d'avoir du sens. Elle doit juste sortir. Listes, fragments, demi-phrases, tout va. Le sens viendra plus tard ou jamais.";

