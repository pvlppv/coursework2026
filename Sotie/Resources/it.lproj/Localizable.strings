"prompts.openers.morning.8" = "Umore a quest'ora: calmo, in ansia, nebbioso o pronto?";
"prompts.openers.morning.9" = "Cosa vuole il resto di te oggi?";
"prompts.openers.morning.10" = "Le mattine sono il momento in cui la giornata è ancora aperta. Quello che ti viene in mente per primo, scrivilo. Non deve voler dire ancora niente.";

// Evening — release, what stayed
"prompts.openers.evening.1" = "Cosa ti è rimasto della giornata?";
"prompts.openers.evening.2" = "Cosa gira ancora dopo oggi?";
"prompts.openers.evening.3" = "Quello a cui torno di oggi è...";
