"prompts.openers.evening.5" = "La giornata è finita. Quello che non hai detto può atterrare qui.";
"prompts.openers.evening.6" = "Non devi riassumere. Un piccolo pezzo basta.";
"prompts.openers.evening.7" = "Com'è stata oggi: leggera, pesante, mista o sfocata?";
"prompts.openers.evening.8" = "Cosa hai notato di più: persone, lavoro, corpo o silenzio?";
"prompts.openers.evening.9" = "Cosa ti ha sorpreso oggi?";
"prompts.openers.evening.10" = "Le sere si portano dietro quello che resta. Il pensiero che non ha trovato posto, la cosa piccola che è ancora forte. Mettila qui.";

// Late night — won't quiet, can't sleep
"prompts.openers.late_night.1" = "Cosa non ti fa dormire?";
