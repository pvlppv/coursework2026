"prompts.openers.stuck.8" = "Da cosa partire: il più piccolo, il più forte, il più vecchio o il più nuovo?";
"prompts.openers.stuck.9" = "Come sarebbe muoversi anche solo un po'?";
"prompts.openers.stuck.10" = "Quando tutto parla insieme, non devi ascoltare tutto. Prendi il filo più vicino e tira. Il resto può aspettare.";

