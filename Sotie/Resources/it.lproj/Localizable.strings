"prompts.openers.late_night.5" = "Non devi risolverlo stanotte. Solo dargli un nome.";
"prompts.openers.late_night.6" = "È tardi. Piccolo basta.";
"prompts.openers.late_night.7" = "Dove vive nel corpo: petto, testa, stomaco o ovunque?";
"prompts.openers.late_night.8" = "Parola più vicina: ansioso, triste, irrequieto o sovreccitato?";
"prompts.openers.late_night.9" = "Cosa aiuterebbe ora, anche solo un po'?";
"prompts.openers.late_night.10" = "La notte ingrandisce le cose. Qualunque sia il pensiero che ti tiene sveglio, puoi metterlo qui senza risolverlo. Che atterri è già abbastanza.";

// Stuck — too many things, can't pick
"prompts.openers.stuck.1" = "Cosa ti tira da tutte le parti?";
"prompts.openers.stuck.2" = "Se potessi pensare a una cosa sola, quale?";
"prompts.openers.stuck.3" = "Il filo più forte ora è...";
"prompts.openers.stuck.4" = "Se dovessi sceglierne uno per iniziare, sarebbe...";
"prompts.openers.stuck.5" = "Non devi sbrogliare tutto. Un pezzo per volta.";
"prompts.openers.stuck.6" = "Bloccato è ok. Inizia da dove vuoi.";
