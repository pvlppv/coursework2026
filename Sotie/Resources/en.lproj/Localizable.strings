// MARK: - Entry Prompts (openers — short, friend-texting tone, sentence case)

// Morning — intention, focus, lens for the day
"prompts.openers.morning.1" = "What do you want to be different today?";
"prompts.openers.morning.2" = "What's the one thing that matters today?";
"prompts.openers.morning.3" = "Today I keep coming back to...";
"prompts.openers.morning.4" = "The first thing on my mind this morning is...";
"prompts.openers.morning.5" = "You don't have to plan the day yet. Start with one word.";
"prompts.openers.morning.6" = "No goals needed. Just say where you're starting from.";
"prompts.openers.morning.7" = "Energy now: heavy, soft, sharp, or scattered?";
"prompts.openers.morning.8" = "Mood at this hour: calm, anxious, foggy, or ready?";
"prompts.openers.morning.9" = "What does the rest of you want today?";
"prompts.openers.morning.10" = "Mornings are where the day still feels open. Whatever's first to come up, write it down. It doesn't have to mean anything yet.";

// Evening — release, what stayed
"prompts.openers.evening.1" = "What stayed with you today?";
"prompts.openers.evening.2" = "What's still circling from today?";
"prompts.openers.evening.3" = "The thing I keep coming back to from today is...";
"prompts.openers.evening.4" = "If today had one word, it would be...";
"prompts.openers.evening.5" = "The day's done. Anything you didn't get to say can land here.";
"prompts.openers.evening.6" = "You don't have to summarize. One small piece is enough.";
"prompts.openers.evening.7" = "How today felt: light, heavy, mixed, or blurry?";
"prompts.openers.evening.8" = "What you noticed most: people, work, body, or quiet?";
"prompts.openers.evening.9" = "What surprised you about today?";
"prompts.openers.evening.10" = "Evenings carry the leftover stuff. The thought that didn't get a place to go yet, the small thing that's still loud. Put it here.";

// Late night — won't quiet, can't sleep
"prompts.openers.late_night.1" = "What won't let you sleep?";
"prompts.openers.late_night.2" = "What's the thought keeping you up?";
"prompts.openers.late_night.3" = "The thought that keeps coming back tonight is...";
"prompts.openers.late_night.4" = "What's loud right now is...";
"prompts.openers.late_night.5" = "You don't need to fix it tonight. Just name it.";
"prompts.openers.late_night.6" = "It's late. Small is enough.";
"prompts.openers.late_night.7" = "Where it lives in the body: chest, head, stomach, or everywhere?";
"prompts.openers.late_night.8" = "Closest word: anxious, sad, restless, or wired?";
"prompts.openers.late_night.9" = "What would help right now, even a little?";
"prompts.openers.late_night.10" = "Night has a way of making things feel bigger. Whatever's keeping you up, you can put it here without solving it. Letting it land is enough.";

// Stuck — too many things, can't pick
"prompts.openers.stuck.1" = "What's pulling at you all at once?";
"prompts.openers.stuck.2" = "If you could only think about one thing, which one?";
"prompts.openers.stuck.3" = "The loudest thread right now is...";
"prompts.openers.stuck.4" = "If I had to pick one thing to start with, it'd be...";
"prompts.openers.stuck.5" = "You don't have to untangle it all. One piece at a time.";
"prompts.openers.stuck.6" = "Stuck is okay. Start anywhere.";
"prompts.openers.stuck.7" = "What's tangled most: time, people, choices, or feelings?";
"prompts.openers.stuck.8" = "Where to start: smallest, loudest, oldest, or newest?";
"prompts.openers.stuck.9" = "What would moving even a little look like?";
"prompts.openers.stuck.10" = "When everything is talking at once, you don't have to listen to all of it. Pick whichever thread is closest and pull on that. The rest can wait.";

// Replay — one thought looping
"prompts.openers.replay.1" = "What thought keeps coming back?";
"prompts.openers.replay.2" = "What part keeps replaying?";
"prompts.openers.replay.3" = "The scene I keep coming back to is...";
"prompts.openers.replay.4" = "The line still running in my head is...";
"prompts.openers.replay.5" = "You don't have to figure out why it's still there. Just put it here.";
"prompts.openers.replay.6" = "It can keep replaying without you having to solve it.";
"prompts.openers.replay.7" = "What it feels like: stuck, unsettled, ashamed, or unfair?";
"prompts.openers.replay.8" = "What you want from it: closure, understanding, an answer, or quiet?";
"prompts.openers.replay.9" = "What does the loop want from you?";
"prompts.openers.replay.10" = "Some thoughts come back not because you missed something but because they're still asking for somewhere to land. This can be that place.";

// Heavy — sad, low, weight
"prompts.openers.heavy.1" = "What feels heavy right now?";
"prompts.openers.heavy.2" = "What's harder than usual?";
"prompts.openers.heavy.3" = "The weight is...";
"prompts.openers.heavy.4" = "What I'm carrying right now is...";
"prompts.openers.heavy.5" = "You don't have to make it lighter. Just say it.";
"prompts.openers.heavy.6" = "Heavy is allowed. Stay here as long as you need.";
"prompts.openers.heavy.7" = "Closest word: sad, low, tired, or hollow?";
"prompts.openers.heavy.8" = "Where you feel it: chest, throat, stomach, or everywhere?";
"prompts.openers.heavy.9" = "What hurts under the hurt?";
"prompts.openers.heavy.10" = "Heavy doesn't always have a clean reason. Sometimes it's just there. Whatever shape it takes, you can put it down here for a minute.";

// Frustrated — anger, blame
"prompts.openers.frustrated.1" = "What's frustrating you?";
"prompts.openers.frustrated.2" = "What did you want that didn't happen?";
"prompts.openers.frustrated.3" = "What's pissing me off is...";
"prompts.openers.frustrated.4" = "What I wish I could've said is...";
"prompts.openers.frustrated.5" = "You don't have to be polite about it here.";
"prompts.openers.frustrated.6" = "Frustration counts. Let it have words.";
"prompts.openers.frustrated.7" = "What it's about: a person, a situation, yourself, or unfairness?";
"prompts.openers.frustrated.8" = "Heat level: simmering, sharp, hot, or burned out?";
"prompts.openers.frustrated.9" = "What's the part that feels unfair?";
"prompts.openers.frustrated.10" = "Anger usually has a reason underneath: something you wanted, something that got crossed. Don't argue with it. Just say what happened and what you needed.";

// Numb — blank, can't access feeling
"prompts.openers.numb.1" = "What does blank feel like right now?";
"prompts.openers.numb.2" = "What were you feeling before this?";
"prompts.openers.numb.3" = "Right now I'm just...";
"prompts.openers.numb.4" = "It's not nothing, it's more like...";
"prompts.openers.numb.5" = "Blank counts. You don't have to find a feeling.";
"prompts.openers.numb.6" = "Quiet is also data. Stay with it.";
"prompts.openers.numb.7" = "Closest word: heavy, empty, frozen, or quiet?";
"prompts.openers.numb.8" = "Volume of feeling: zero, faint, distant, or muted?";
"prompts.openers.numb.9" = "When did the volume drop?";
"prompts.openers.numb.10" = "Numb doesn't mean nothing's there. It usually means something's underneath that doesn't have a name yet. You don't have to find it tonight.";

// Anxious — forward dread, can't settle
"prompts.openers.anxious.1" = "What are you anxious about?";
"prompts.openers.anxious.2" = "Where do you feel it in your body?";
"prompts.openers.anxious.3" = "What's racing in my head is...";
"prompts.openers.anxious.4" = "The worst-case I keep going to is...";
"prompts.openers.anxious.5" = "You don't have to make it stop. Just describe it.";
"prompts.openers.anxious.6" = "Anxious is loud. Slow is okay.";
"prompts.openers.anxious.7" = "Where it shows up: chest, stomach, throat, or breathing?";
"prompts.openers.anxious.8" = "Pace: fast, looping, jumpy, or stuck?";
"prompts.openers.anxious.9" = "What would calmer look like, even slightly?";
"prompts.openers.anxious.10" = "Anxiety often points at something but uses panic as the messenger. You don't have to trust the panic. Just listen to what it's pointing at.";

// Restless — don't want to be where I am
"prompts.openers.restless.1" = "What's pulling at you right now?";
"prompts.openers.restless.2" = "What feels off about right now?";
"prompts.openers.restless.3" = "I keep wanting to...";
"prompts.openers.restless.4" = "Where I actually want to be is...";
"prompts.openers.restless.5" = "Restless is information. Don't fight it.";
"prompts.openers.restless.6" = "You don't have to know what for. Just say it's there.";
"prompts.openers.restless.7" = "What it feels like: itchy, bored, trapped, or fidgety?";
"prompts.openers.restless.8" = "What's off: place, pace, people, or yourself?";
"prompts.openers.restless.9" = "What's the unrest pointing toward?";
"prompts.openers.restless.10" = "Restless usually means a part of you wants something different from what's happening. You don't have to act on it yet. Just notice what it's pointing at.";

// Decision — fork, what-if
"prompts.openers.decision.1" = "What's the choice you're avoiding?";
"prompts.openers.decision.2" = "What do you actually want, before the reasons?";
"prompts.openers.decision.3" = "The thing I keep going back and forth on is...";
"prompts.openers.decision.4" = "If no one were watching, I'd...";
"prompts.openers.decision.5" = "You don't have to decide tonight. Just see it more clearly.";
"prompts.openers.decision.6" = "There's no wrong answer here. Only honest ones.";
"prompts.openers.decision.7" = "What's blocking you: fear, fairness, others, or money?";
"prompts.openers.decision.8" = "How it feels: stuck, torn, urgent, or quiet?";
"prompts.openers.decision.9" = "What's the cost of staying still?";
"prompts.openers.decision.10" = "Decisions get clearer when you stop arguing with yourself and just listen. Say what you want first. The reasons can come after.";

// Someone — about another person
"prompts.openers.someone.1" = "Who's on your mind right now?";
"prompts.openers.someone.2" = "What did they do or say?";
"prompts.openers.someone.3" = "The person I keep thinking about is...";
"prompts.openers.someone.4" = "What I wish they understood is...";
"prompts.openers.someone.5" = "You don't have to be fair about it here.";
"prompts.openers.someone.6" = "Whatever you can't say to them, you can say here.";
"prompts.openers.someone.7" = "What you feel toward them: hurt, angry, missing, or torn?";
"prompts.openers.someone.8" = "What's left between you: silence, distance, words, or hope?";
"prompts.openers.someone.9" = "What did you need from them?";
"prompts.openers.someone.10" = "Other people leave fingerprints. Even when nothing happened, something can stay. Whoever's on your mind, start with them and what they bring up in you.";

// You vs them — self vs others, "we", "should"
"prompts.openers.you_vs_them.1" = "What do you want, separate from them?";
"prompts.openers.you_vs_them.2" = "Who's this for, really?";
"prompts.openers.you_vs_them.3" = "If it cost me nothing to say no, I'd...";
"prompts.openers.you_vs_them.4" = "What I actually want, not what I should want, is...";
"prompts.openers.you_vs_them.5" = "You're allowed to want something different from what they want.";
"prompts.openers.you_vs_them.6" = "There's no betrayal in being honest with yourself.";
"prompts.openers.you_vs_them.7" = "Whose voice is loudest: yours, family, partner, or culture?";
"prompts.openers.you_vs_them.8" = "What you'd lose by choosing yours: approval, comfort, peace, or guilt?";
"prompts.openers.you_vs_them.9" = "What's the should doing in your head?";
"prompts.openers.you_vs_them.10" = "Sometimes the hardest part is hearing your own voice over everyone else's. You don't have to choose yet. Just let yours be the loudest in here.";

// Change — transitions, endings, beginnings
"prompts.openers.change.1" = "What's changing right now?";
"prompts.openers.change.2" = "What are you leaving behind?";
"prompts.openers.change.3" = "What I'm not sure I'm ready to leave is...";
"prompts.openers.change.4" = "What I'm reaching for is...";
"prompts.openers.change.5" = "You can grieve what you're leaving and still want what's next.";
"prompts.openers.change.6" = "In-between is allowed. You don't have to be settled.";
"prompts.openers.change.7" = "What it feels like: scary, exciting, sad, or all of it?";
"prompts.openers.change.8" = "Where you are: ending, middle, beginning, or somewhere unclear?";
"prompts.openers.change.9" = "What's grief and what's hope in this?";
"prompts.openers.change.10" = "Change is rarely just one feeling. There's usually a part that's mourning and a part that's reaching. Both can be true at the same time.";

// Wins — what clicked, breakthroughs
"prompts.openers.wins.1" = "What clicked today?";
"prompts.openers.wins.2" = "What surprised you about yourself?";
"prompts.openers.wins.3" = "Something I did well today is...";
"prompts.openers.wins.4" = "A small thing that worked is...";
"prompts.openers.wins.5" = "Small counts. You don't have to call it big.";
"prompts.openers.wins.6" = "Take this. You earned it.";
"prompts.openers.wins.7" = "Where the win is: action, mindset, kindness, or rest?";
"prompts.openers.wins.8" = "How it feels: proud, relieved, surprised, or steady?";
"prompts.openers.wins.9" = "What did past-you do that helped?";
"prompts.openers.wins.10" = "Wins don't have to be loud or visible. Sometimes the win is that you didn't spiral. Sometimes it's that you started. Whatever yours looks like, count it.";

// Gratitude — what's already there
"prompts.openers.gratitude.1" = "What's worth noticing today?";
"prompts.openers.gratitude.2" = "What's easy to forget but matters?";
"prompts.openers.gratitude.3" = "Something small I'm glad about is...";
"prompts.openers.gratitude.4" = "What helped, even a little, was...";
"prompts.openers.gratitude.5" = "Don't force it. Just notice what's already there.";
"prompts.openers.gratitude.6" = "Small is enough.";
"prompts.openers.gratitude.7" = "Where to look: a person, a moment, a place, or your body?";
"prompts.openers.gratitude.8" = "What kind: helpful, soft, ordinary, or unexpected?";
"prompts.openers.gratitude.9" = "What did you almost miss today?";
"prompts.openers.gratitude.10" = "Gratitude doesn't have to be a big list. One specific thing, a person who showed up, a window of quiet, your body doing what it does, is enough to count.";

// Patterns — meta, recurring shapes
"prompts.openers.patterns.1" = "What keeps coming back lately?";
"prompts.openers.patterns.2" = "What's the same in different situations?";
"prompts.openers.patterns.3" = "The thing I keep doing is...";
"prompts.openers.patterns.4" = "I notice this happens when...";
"prompts.openers.patterns.5" = "Patterns aren't verdicts. They're information.";
"prompts.openers.patterns.6" = "You don't have to fix it just because you saw it.";
"prompts.openers.patterns.7" = "Where it shows up: work, relationships, health, or moods?";
"prompts.openers.patterns.8" = "Pattern type: avoiding, reaching, repeating, or shrinking?";
"prompts.openers.patterns.9" = "What does this remind you of?";
"prompts.openers.patterns.10" = "Patterns aren't always proof of something wrong. Sometimes they're old solutions that used to work and don't anymore. Naming one is the first soft step.";

// Future self — the version of you ahead
"prompts.openers.future_self.1" = "What would future you want you to know?";
"prompts.openers.future_self.2" = "What do you want to be true a year from now?";
"prompts.openers.future_self.3" = "A year from now I want to be...";
"prompts.openers.future_self.4" = "What I'd thank past-me for is...";
"prompts.openers.future_self.5" = "Future you isn't watching to judge. They're hoping for you.";
"prompts.openers.future_self.6" = "Small starts count.";
"prompts.openers.future_self.7" = "What you're building toward: clarity, courage, ease, or honesty?";
"prompts.openers.future_self.8" = "Where to start: habit, relationship, work, or self?";
"prompts.openers.future_self.9" = "What's the small thing that compounds?";
"prompts.openers.future_self.10" = "Future you isn't a stranger. They're the version of you that knows what this version was carrying. Whatever you say to them, they're listening.";

// Returning — long gap (>3 days)
"prompts.openers.returning.1" = "What's been carrying since last time?";
"prompts.openers.returning.2" = "What's changed?";
"prompts.openers.returning.3" = "Since I was last here, what's stayed is...";
"prompts.openers.returning.4" = "What pulled me back today is...";
"prompts.openers.returning.5" = "You don't have to explain the gap. Just start from now.";
"prompts.openers.returning.6" = "Welcome back. Wherever you start is the right place.";
"prompts.openers.returning.7" = "What's louder now: same thing, new thing, or quieter version?";
"prompts.openers.returning.8" = "How you feel returning: tired, glad, unsure, or ready?";
"prompts.openers.returning.9" = "What did the gap remind you of?";
"prompts.openers.returning.10" = "You came back. That counts. Whatever stayed in the silence between visits, you can put down here without explanation.";

// Continue — fresh thread (<24h, has assistant reply)
"prompts.openers.continue.1" = "Where did you leave off?";
"prompts.openers.continue.2" = "What's still circling from earlier?";
"prompts.openers.continue.3" = "Picking up where I left off, the part that's still loud is...";
"prompts.openers.continue.4" = "What I want to come back to is...";
"prompts.openers.continue.5" = "You can pick up partway. You don't have to start over.";
"prompts.openers.continue.6" = "Whatever's still here, it's worth another minute.";
"prompts.openers.continue.7" = "What's clearer now: a little, somewhat, or still murky?";
"prompts.openers.continue.8" = "What's pulling you back: a feeling, a thought, a person, or the loop itself?";
"prompts.openers.continue.9" = "What's the next thing you want to say about this?";
"prompts.openers.continue.10" = "Some thoughts need more than one sitting. You can return as many times as it takes. The thread is still here.";

// Brain dump — catch-all
"prompts.openers.brain_dump.1" = "What's on your mind right now?";
"prompts.openers.brain_dump.2" = "What's noisiest in your head?";
"prompts.openers.brain_dump.3" = "Right now my head is full of...";
"prompts.openers.brain_dump.4" = "The first thing that comes up is...";
"prompts.openers.brain_dump.5" = "Mess is welcome. No structure needed.";
"prompts.openers.brain_dump.6" = "Just write. Sense can come later.";
"prompts.openers.brain_dump.7" = "Volume: loud, scattered, looping, or quiet but stuck?";
"prompts.openers.brain_dump.8" = "What it's about: today, lately, forever, or unclear?";
"prompts.openers.brain_dump.9" = "What thought has been following you?";
"prompts.openers.brain_dump.10" = "A brain dump doesn't have to make sense. It just has to come out. Lists, fragments, half-sentences are all fine. Sense can come later or never.";

