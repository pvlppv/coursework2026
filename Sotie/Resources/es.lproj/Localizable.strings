"prompts.openers.continue.7" = "Qué está más claro: un poco, algo o sigue turbio?";
"prompts.openers.continue.8" = "Qué te trae de vuelta: un sentir, un pensar, una persona o el bucle mismo?";
"prompts.openers.continue.9" = "¿Qué es lo siguiente que quieres decir sobre esto?";
"prompts.openers.continue.10" = "Algunos pensamientos piden más de una sentada. Puedes volver tantas veces como necesites. El hilo sigue ahí.";

