// Morning — intention, focus, lens for the day
"prompts.openers.morning.1" = "¿Qué quieres que sea distinto hoy?";
"prompts.openers.morning.2" = "¿Qué importa hoy más que nada?";
"prompts.openers.morning.3" = "Hoy vuelvo a pensar en...";
"prompts.openers.morning.4" = "Lo primero que tengo en la cabeza esta mañana es...";
"prompts.openers.morning.5" = "No tienes que planear el día aún. Empieza con una palabra.";
"prompts.openers.morning.6" = "Sin metas. Solo di desde dónde arrancas.";
"prompts.openers.morning.7" = "Energía ahora: pesada, suave, aguda o dispersa?";
"prompts.openers.morning.8" = "Ánimo a esta hora: tranquilo, ansioso, nublado o listo?";
"prompts.openers.morning.9" = "¿Qué quiere el resto de ti hoy?";
"prompts.openers.morning.10" = "Las mañanas son cuando el día aún está abierto. Lo primero que aparezca, escríbelo. No tiene que significar nada todavía.";

// Evening — release, what stayed
"prompts.openers.evening.1" = "¿Qué te quedó del día?";
"prompts.openers.evening.2" = "¿Qué sigue dando vueltas de hoy?";
"prompts.openers.evening.3" = "Aquello a lo que vuelvo de hoy es...";
"prompts.openers.evening.4" = "Si el día tuviera una palabra, sería...";
"prompts.openers.evening.5" = "Se acabó el día. Lo que no dijiste puede aterrizar aquí.";
"prompts.openers.evening.6" = "No tienes que resumir. Una pieza pequeña basta.";
"prompts.openers.evening.7" = "Cómo se sintió hoy: ligero, pesado, mezclado o borroso?";
"prompts.openers.evening.8" = "Lo que más notaste: gente, trabajo, cuerpo o silencio?";
"prompts.openers.evening.9" = "¿Qué te sorprendió hoy?";
"prompts.openers.evening.10" = "Las noches cargan con lo que sobra. El pensamiento que no halló sitio, lo pequeño que aún suena fuerte. Déjalo aquí.";

// Late night — won't quiet, can't sleep
"prompts.openers.late_night.1" = "¿Qué no te deja dormir?";
"prompts.openers.late_night.2" = "¿Qué pensamiento te mantiene despierto?";
"prompts.openers.late_night.3" = "El pensamiento que vuelve esta noche es...";
"prompts.openers.late_night.4" = "Lo que está fuerte ahora es...";
"prompts.openers.late_night.5" = "No tienes que arreglarlo esta noche. Solo nómbralo.";
"prompts.openers.late_night.6" = "Es tarde. Lo pequeño basta.";
"prompts.openers.late_night.7" = "Dónde vive en el cuerpo: pecho, cabeza, estómago o todo?";
"prompts.openers.late_night.8" = "Palabra cercana: ansioso, triste, inquieto o acelerado?";
"prompts.openers.late_night.9" = "¿Qué ayudaría ahora, aunque sea poco?";
"prompts.openers.late_night.10" = "La noche agranda las cosas. Lo que sea que te mantenga despierto, déjalo aquí sin resolverlo. Que aterrice ya es suficiente.";

// Stuck — too many things, can't pick
"prompts.openers.stuck.1" = "¿Qué tira de ti todo a la vez?";
"prompts.openers.stuck.2" = "Si solo pudieras pensar en una cosa, ¿cuál?";
"prompts.openers.stuck.3" = "El hilo más fuerte ahora es...";
"prompts.openers.stuck.4" = "Si tuviera que elegir uno para empezar, sería...";
"prompts.openers.stuck.5" = "No tienes que desenredar todo. Pieza por pieza.";
"prompts.openers.stuck.6" = "Estar atascado está bien. Empieza por cualquier sitio.";
"prompts.openers.stuck.7" = "Qué está más enredado: tiempo, gente, decisiones o sentimientos?";
"prompts.openers.stuck.8" = "Por dónde empezar: lo más pequeño, fuerte, antiguo o reciente?";
"prompts.openers.stuck.9" = "¿Cómo se vería moverse aunque sea un poco?";
"prompts.openers.stuck.10" = "Cuando todo habla a la vez, no hace falta escucharlo todo. Toma el hilo más cercano y tira de él. Lo demás puede esperar.";

// Replay — one thought looping
"prompts.openers.replay.1" = "¿Qué pensamiento vuelve?";
"prompts.openers.replay.2" = "¿Qué parte se repite?";
"prompts.openers.replay.3" = "La escena a la que vuelvo es...";
"prompts.openers.replay.4" = "La frase que me sigue sonando es...";
"prompts.openers.replay.5" = "No tienes que entender por qué sigue ahí. Solo ponlo aquí.";
"prompts.openers.replay.6" = "Puede seguir repitiéndose sin que tengas que resolverlo.";
"prompts.openers.replay.7" = "Cómo se siente: atascado, inquieto, vergonzoso o injusto?";
"prompts.openers.replay.8" = "Qué quieres de ello: cierre, comprensión, una respuesta o silencio?";
"prompts.openers.replay.9" = "¿Qué quiere ese bucle de ti?";
"prompts.openers.replay.10" = "Hay pensamientos que vuelven no porque te perdiste algo, sino porque aún piden un sitio donde aterrizar. Que sea aquí.";

// Heavy — sad, low, weight
"prompts.openers.heavy.1" = "¿Qué se siente pesado?";
"prompts.openers.heavy.2" = "¿Qué cuesta más que otras veces?";
"prompts.openers.heavy.3" = "El peso es...";
"prompts.openers.heavy.4" = "Lo que cargo ahora es...";
"prompts.openers.heavy.5" = "No tienes que aligerarlo. Solo dilo.";
"prompts.openers.heavy.6" = "Pesado se vale. Quédate aquí lo que necesites.";
"prompts.openers.heavy.7" = "Palabra cercana: triste, bajo, cansado o vacío?";
"prompts.openers.heavy.8" = "Dónde lo sientes: pecho, garganta, estómago o todo?";
"prompts.openers.heavy.9" = "¿Qué duele debajo del dolor?";
"prompts.openers.heavy.10" = "Lo pesado no siempre tiene una razón clara. A veces solo está. Sea como sea su forma, puedes dejarlo aquí un rato.";

// Frustrated — anger, blame
"prompts.openers.frustrated.1" = "¿Qué te frustra?";
"prompts.openers.frustrated.2" = "¿Qué querías que no pasó?";
"prompts.openers.frustrated.3" = "Lo que me molesta es...";
"prompts.openers.frustrated.4" = "Lo que ojalá hubiera dicho es...";
"prompts.openers.frustrated.5" = "Aquí no hace falta ser educado.";
"prompts.openers.frustrated.6" = "La frustración cuenta. Que tenga palabras.";
"prompts.openers.frustrated.7" = "De qué se trata: una persona, una situación, tú o injusticia?";
"prompts.openers.frustrated.8" = "Nivel de calor: lento, agudo, ardiente o quemado?";
"prompts.openers.frustrated.9" = "¿Qué se siente injusto en esto?";
"prompts.openers.frustrated.10" = "La rabia suele tener una razón debajo: algo que querías, algo que cruzaron. No discutas con ella. Solo di qué pasó y qué necesitabas.";

// Numb — blank, can't access feeling
"prompts.openers.numb.1" = "¿Cómo se siente el vacío ahora?";
"prompts.openers.numb.2" = "¿Qué sentías antes de esto?";
"prompts.openers.numb.3" = "Ahora mismo solo estoy...";
"prompts.openers.numb.4" = "No es nada, es más como...";
"prompts.openers.numb.5" = "El vacío cuenta. No tienes que encontrar un sentimiento.";
"prompts.openers.numb.6" = "El silencio también es información. Quédate con él.";
"prompts.openers.numb.7" = "Palabra cercana: pesado, vacío, congelado o quieto?";
"prompts.openers.numb.8" = "Volumen del sentir: cero, leve, lejano o apagado?";
"prompts.openers.numb.9" = "¿Cuándo bajó el volumen?";
"prompts.openers.numb.10" = "Adormecido no significa que no haya nada. Suele significar que hay algo debajo sin nombre. No tienes que encontrarlo hoy.";

// Anxious — forward dread, can't settle
"prompts.openers.anxious.1" = "¿Por qué estás ansioso?";
"prompts.openers.anxious.2" = "¿Dónde lo sientes en el cuerpo?";
"prompts.openers.anxious.3" = "Lo que corre en mi cabeza es...";
"prompts.openers.anxious.4" = "El peor escenario al que voy es...";
"prompts.openers.anxious.5" = "No tienes que pararlo. Solo descríbelo.";
"prompts.openers.anxious.6" = "La ansiedad es ruidosa. Lento se vale.";
"prompts.openers.anxious.7" = "Dónde aparece: pecho, estómago, garganta o respiración?";
"prompts.openers.anxious.8" = "Ritmo: rápido, en bucle, saltando o atrapado?";
"prompts.openers.anxious.9" = "¿Cómo se vería más calma, aunque sea un poco?";
"prompts.openers.anxious.10" = "La ansiedad suele apuntar a algo, pero usa el pánico como mensajero. No tienes que creerle al pánico. Solo escucha a qué apunta.";

// Restless — don't want to be where I am
"prompts.openers.restless.1" = "¿Qué tira de ti ahora?";
"prompts.openers.restless.2" = "¿Qué se siente fuera de lugar en este momento?";
"prompts.openers.restless.3" = "Sigo queriendo...";
"prompts.openers.restless.4" = "Donde quiero estar de verdad es...";
"prompts.openers.restless.5" = "La inquietud es información. No la pelees.";
"prompts.openers.restless.6" = "No tienes que saber para qué. Solo di que está ahí.";
"prompts.openers.restless.7" = "Cómo se siente: con picazón, aburrido, atrapado o nervioso?";
"prompts.openers.restless.8" = "Qué está fuera: lugar, ritmo, gente o tú?";
"prompts.openers.restless.9" = "¿Hacia dónde apunta la inquietud?";
"prompts.openers.restless.10" = "Inquieto suele querer decir que una parte de ti quiere algo distinto a lo que pasa. No tienes que actuar aún. Solo nota a qué apunta.";

// Decision — fork, what-if
"prompts.openers.decision.1" = "¿Qué decisión estás evitando?";
"prompts.openers.decision.2" = "¿Qué quieres en realidad, antes de las razones?";
"prompts.openers.decision.3" = "Lo que voy y vengo es...";
"prompts.openers.decision.4" = "Si nadie estuviera mirando, yo...";
"prompts.openers.decision.5" = "No tienes que decidir esta noche. Solo verlo más claro.";
"prompts.openers.decision.6" = "Aquí no hay respuestas equivocadas. Solo honestas.";
"prompts.openers.decision.7" = "Qué te frena: miedo, justicia, los demás o el dinero?";
"prompts.openers.decision.8" = "Cómo se siente: atascado, partido, urgente o quieto?";
"prompts.openers.decision.9" = "¿Qué te cuesta no moverte?";
"prompts.openers.decision.10" = "Las decisiones se aclaran cuando dejas de discutir contigo y solo escuchas. Di primero qué quieres. Las razones llegan después.";

// Someone — about another person
"prompts.openers.someone.1" = "¿Quién te ronda en la cabeza ahora?";
"prompts.openers.someone.2" = "¿Qué hicieron o dijeron?";
"prompts.openers.someone.3" = "La persona en la que pienso es...";
"prompts.openers.someone.4" = "Lo que querría que entendieran es...";
"prompts.openers.someone.5" = "Aquí no tienes que ser justo.";
"prompts.openers.someone.6" = "Lo que no puedas decirles, dilo aquí.";
"prompts.openers.someone.7" = "Qué sientes hacia ellos: dolido, enojado, los extrañas o partido?";
"prompts.openers.someone.8" = "Qué queda entre ustedes: silencio, distancia, palabras o esperanza?";
"prompts.openers.someone.9" = "¿Qué necesitabas de ellos?";
"prompts.openers.someone.10" = "Las personas dejan huella. Aunque no haya pasado nada, algo puede quedarse. Quien sea que esté en tu cabeza, empieza por él y por lo que despierta en ti.";

// You vs them — self vs others, "we", "should"
"prompts.openers.you_vs_them.1" = "¿Qué quieres tú, aparte de ellos?";
"prompts.openers.you_vs_them.2" = "¿Para quién es esto, en verdad?";
"prompts.openers.you_vs_them.3" = "Si decir no no me costara nada, yo...";
"prompts.openers.you_vs_them.4" = "Lo que de verdad quiero, no lo que debería querer, es...";
"prompts.openers.you_vs_them.5" = "Puedes querer algo distinto a lo que ellos quieren.";
"prompts.openers.you_vs_them.6" = "Ser honesto contigo no es traicionarlos.";
"prompts.openers.you_vs_them.7" = "Qué voz suena más fuerte: la tuya, familia, pareja o cultura?";
"prompts.openers.you_vs_them.8" = "Qué perderías si eliges lo tuyo: aprobación, comodidad, paz o culpa?";
"prompts.openers.you_vs_them.9" = "¿Qué hace ese debería en tu cabeza?";
"prompts.openers.you_vs_them.10" = "A veces lo más difícil es escuchar tu propia voz por encima del resto. No tienes que elegir aún. Solo deja que aquí la tuya sea la más fuerte.";

// Change — transitions, endings, beginnings
"prompts.openers.change.1" = "¿Qué está cambiando ahora?";
"prompts.openers.change.2" = "¿Qué estás dejando atrás?";
"prompts.openers.change.3" = "Lo que no estoy seguro de soltar es...";
"prompts.openers.change.4" = "Hacia lo que estoy yendo es...";
"prompts.openers.change.5" = "Puedes despedirte y querer lo que viene a la vez.";
"prompts.openers.change.6" = "El intermedio se vale. No tienes que estar acomodado.";
"prompts.openers.change.7" = "Cómo se siente: dar miedo, emocionar, dar pena o todo a la vez?";
"prompts.openers.change.8" = "Dónde estás: en el final, en el medio, al inicio o no claro?";
"prompts.openers.change.9" = "¿Qué es duelo y qué esperanza en esto?";
"prompts.openers.change.10" = "El cambio rara vez es un solo sentimiento. Suele haber una parte que se despide y otra que se estira hacia delante. Las dos pueden ser ciertas.";

// Wins — what clicked, breakthroughs
"prompts.openers.wins.1" = "¿Qué encajó hoy?";
"prompts.openers.wins.2" = "¿Qué te sorprendió de ti?";
"prompts.openers.wins.3" = "Algo que hice bien hoy es...";
"prompts.openers.wins.4" = "Una cosa pequeña que funcionó es...";
"prompts.openers.wins.5" = "Lo pequeño cuenta. No tiene que ser grande.";
"prompts.openers.wins.6" = "Tómalo. Te lo ganaste.";
"prompts.openers.wins.7" = "Dónde está el logro: acción, mente, amabilidad o descanso?";
"prompts.openers.wins.8" = "Cómo se siente: orgulloso, aliviado, sorprendido o estable?";
"prompts.openers.wins.9" = "¿Qué hizo tu yo de antes que ayudó?";
"prompts.openers.wins.10" = "Los logros no tienen que ser ruidosos ni visibles. A veces el logro es no caer en espiral. A veces es haber empezado. Como sea el tuyo, cuéntalo.";

// Gratitude — what's already there
"prompts.openers.gratitude.1" = "¿Qué vale la pena notar hoy?";
"prompts.openers.gratitude.2" = "¿Qué se olvida fácil pero importa?";
"prompts.openers.gratitude.3" = "Algo pequeño que me alegra es...";
"prompts.openers.gratitude.4" = "Lo que ayudó, aunque sea un poco, fue...";
"prompts.openers.gratitude.5" = "No fuerces. Solo nota lo que ya está.";
"prompts.openers.gratitude.6" = "Pequeño basta.";
"prompts.openers.gratitude.7" = "Dónde mirar: una persona, un momento, un lugar o tu cuerpo?";
"prompts.openers.gratitude.8" = "Qué tipo: útil, suave, cotidiano o inesperado?";
"prompts.openers.gratitude.9" = "¿Qué casi pasaste por alto hoy?";
"prompts.openers.gratitude.10" = "La gratitud no tiene que ser una lista larga. Una cosa concreta, alguien que apareció, una ventana de calma, tu cuerpo haciendo lo suyo, ya cuenta.";

// Patterns — meta, recurring shapes
"prompts.openers.patterns.1" = "¿Qué se repite últimamente?";
"prompts.openers.patterns.2" = "¿Qué es igual en distintas situaciones?";
"prompts.openers.patterns.3" = "Lo que sigo haciendo es...";
"prompts.openers.patterns.4" = "Noto que esto pasa cuando...";
"prompts.openers.patterns.5" = "Los patrones no son sentencias. Son información.";
"prompts.openers.patterns.6" = "No tienes que arreglarlo solo porque lo viste.";
"prompts.openers.patterns.7" = "Dónde aparece: trabajo, relaciones, salud o ánimos?";
"prompts.openers.patterns.8" = "Tipo de patrón: evitar, alcanzar, repetir o encogerse?";
"prompts.openers.patterns.9" = "¿A qué te recuerda esto?";
"prompts.openers.patterns.10" = "Los patrones no siempre prueban que algo está mal. A veces son soluciones viejas que sí funcionaban y ya no. Nombrar uno es el primer paso suave.";

// Future self — the version of you ahead
"prompts.openers.future_self.1" = "¿Qué querría tu yo del futuro que supieras?";
"prompts.openers.future_self.2" = "¿Qué quieres que sea cierto en un año?";
"prompts.openers.future_self.3" = "Dentro de un año quiero estar...";
"prompts.openers.future_self.4" = "Por lo que le agradecería a mi yo de antes es...";
"prompts.openers.future_self.5" = "Tu yo del futuro no juzga. Te está esperando.";
"prompts.openers.future_self.6" = "Los pequeños comienzos cuentan.";
"prompts.openers.future_self.7" = "Hacia qué estás yendo: claridad, valentía, ligereza u honestidad?";
"prompts.openers.future_self.8" = "Por dónde empezar: hábito, relación, trabajo o tú mismo?";
"prompts.openers.future_self.9" = "¿Cuál es la cosa pequeña que se acumula?";
"prompts.openers.future_self.10" = "Tu yo del futuro no es un extraño. Es la versión que sabe lo que esta versión cargaba. Lo que le digas, te oye.";

// Returning — long gap (>3 days)
"prompts.openers.returning.1" = "¿Qué se ha quedado contigo desde la última vez?";
"prompts.openers.returning.2" = "¿Qué cambió?";
"prompts.openers.returning.3" = "Desde la última vez que estuve aquí, ha quedado...";
"prompts.openers.returning.4" = "Lo que me trajo de vuelta hoy es...";
