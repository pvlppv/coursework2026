"prompts.openers.returning.7" = "Qué suena más fuerte: lo mismo, algo nuevo o más bajo?";
"prompts.openers.returning.8" = "Cómo te sientes al volver: cansado, contento, no seguro o listo?";
"prompts.openers.returning.9" = "¿De qué te recordó la pausa?";
"prompts.openers.returning.10" = "Volviste. Eso cuenta. Lo que se quedó en el silencio entre visitas, déjalo aquí sin explicar.";

