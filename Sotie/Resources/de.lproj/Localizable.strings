// Morning — intention, focus, lens for the day
"prompts.openers.morning.1" = "Was möchtest du heute anders machen?";
"prompts.openers.morning.2" = "Was zählt heute am meisten?";
"prompts.openers.morning.3" = "Heute kehre ich gedanklich zurück zu...";
"prompts.openers.morning.4" = "Das Erste, was mir heute Morgen im Kopf ist, ist...";
"prompts.openers.morning.5" = "Du musst den Tag noch nicht planen. Fang mit einem Wort an.";
"prompts.openers.morning.6" = "Keine Ziele nötig. Sag einfach, von wo du startest.";
"prompts.openers.morning.7" = "Energie jetzt: schwer, weich, scharf oder zerstreut?";
"prompts.openers.morning.8" = "Stimmung um diese Stunde: ruhig, ängstlich, neblig oder bereit?";
"prompts.openers.morning.9" = "Was will der Rest von dir heute?";
"prompts.openers.morning.10" = "Morgens fühlt sich der Tag noch offen an. Was als Erstes hochkommt, schreib es auf. Es muss noch nichts bedeuten.";

// Evening — release, what stayed
"prompts.openers.evening.1" = "Was ist dir vom Tag geblieben?";
"prompts.openers.evening.2" = "Was kreist noch von heute?";
"prompts.openers.evening.3" = "Worauf ich heute immer wieder zurückkomme, ist...";
"prompts.openers.evening.4" = "Wenn der heutige Tag ein Wort hätte, wäre es...";
"prompts.openers.evening.5" = "Der Tag ist vorbei. Alles, was du nicht sagen konntest, kann hier landen.";
"prompts.openers.evening.6" = "Du musst nichts zusammenfassen. Ein kleines Stück reicht.";
"prompts.openers.evening.7" = "Wie der Tag sich anfühlte: leicht, schwer, gemischt oder verschwommen?";
"prompts.openers.evening.8" = "Was du am meisten gespürt hast: Menschen, Arbeit, Körper oder Stille?";
"prompts.openers.evening.9" = "Was hat dich heute überrascht?";
"prompts.openers.evening.10" = "Abende tragen das, was übrig blieb. Der Gedanke, der noch keinen Platz fand, die kleine Sache, die noch laut ist. Leg sie hier ab.";

// Late night — won't quiet, can't sleep
