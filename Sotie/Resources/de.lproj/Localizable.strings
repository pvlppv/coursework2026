"prompts.openers.late_night.2" = "Welcher Gedanke hält dich wach?";
"prompts.openers.late_night.3" = "Der Gedanke, der heute Nacht zurückkehrt, ist...";
"prompts.openers.late_night.4" = "Was gerade laut ist, ist...";
"prompts.openers.late_night.5" = "Du musst es heute Nacht nicht lösen. Benenn es einfach.";
"prompts.openers.late_night.6" = "Es ist spät. Klein reicht.";
"prompts.openers.late_night.7" = "Wo es im Körper sitzt: Brust, Kopf, Bauch oder überall?";
"prompts.openers.late_night.8" = "Nächstes Wort: ängstlich, traurig, unruhig oder aufgedreht?";
"prompts.openers.late_night.9" = "Was würde gerade helfen, auch nur ein bisschen?";
"prompts.openers.late_night.10" = "Nachts wirken Dinge größer. Was dich auch wach hält, leg es hier ab, ohne es zu lösen. Dass es ankommt, reicht.";

// Stuck — too many things, can't pick
"prompts.openers.stuck.1" = "Was zieht alles gleichzeitig an dir?";
"prompts.openers.stuck.2" = "Wenn du nur an eines denken könntest, an was?";
"prompts.openers.stuck.3" = "Der lauteste Faden gerade ist...";
"prompts.openers.stuck.4" = "Wenn ich mit einer Sache anfangen müsste, wäre es...";
"prompts.openers.stuck.5" = "Du musst nicht alles entwirren. Stück für Stück.";
"prompts.openers.stuck.6" = "Festsitzen ist okay. Fang irgendwo an.";
